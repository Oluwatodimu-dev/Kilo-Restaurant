PORT=3000
# Where db.json and uploaded images live. On Render/Railway point this at a persistent disk.
DATA_DIR=./data
SITE_URL=https://www.yourrestaurant.com
# Optional: protects first-time admin setup so nobody else can claim it before you
ADMIN_SETUP_KEY=
# Set to 1 when behind a proxy/CDN
TRUST_PROXY=1
